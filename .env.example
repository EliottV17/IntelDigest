# PostgreSQL
DATABASE_URL=postgres://inteldigest:inteldigest@localhost:5432/inteldigest?sslmode=disable

# Redis (siguiente tarea)
REDIS_URL=redis://localhost:6379

# API
API_PORT=8080

# OpenRouter (siguiente tarea)
OPENROUTER_API_KEY=

# Redis queue
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=inteldigest:jobs
REDIS_DIAL_TIMEOUT=5s
REDIS_PUBLISH_TIMEOUT=2s

# Worker
WORKER_POOL_SIZE=4
WORKER_CONSUMER_GROUP=inteldigest:workers

# Default: nombre autogenerado con hostname y UUID cuando la variable no está definida.
# Si se configura manualmente, debe ser no vacío y único entre procesos.
# WORKER_CONSUMER_NAME=worker-1

WORKER_STREAM_BLOCK=2s
WORKER_QUEUE_OPERATION_TIMEOUT=5s
WORKER_DB_TIMEOUT=5s
WORKER_SHUTDOWN_TIMEOUT=10s

# Scraper
SCRAPER_CONNECT_TIMEOUT=5s
SCRAPER_TLS_TIMEOUT=5s
SCRAPER_HEADER_TIMEOUT=10s
SCRAPER_READ_TIMEOUT=10s
SCRAPER_REQUEST_TIMEOUT=30s
SCRAPER_MAX_BODY_BYTES=5242880
SCRAPER_MAX_REDIRECTS=5
